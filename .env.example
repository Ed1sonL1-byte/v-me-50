# Server-side configuration for create_engine(). Never commit real credentials.
SUPABASE_URL=https://cgnkdgkzmnsxojnxjbzj.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_project_publishable_key
OPENAI_API_KEY=replace_with_deepseek_api_key
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
# LangChain's Pydantic output uses a forced tool call; DeepSeek requires non-thinking mode for this.
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
RETRIEVAL_TIMEOUT_SECONDS=30
RAG_CANDIDATE_LIMIT=20
EMBEDDING_MODEL=BAAI/bge-m3
