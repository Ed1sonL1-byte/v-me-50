# Browser requests use this prefix. Production should route /api through the gateway.
VITE_GATEWAY_BASE_URL=/api

# Vite development server only. This variable is not exposed to the browser.
GATEWAY_PROXY_TARGET=http://127.0.0.1:8000

# Optional gateway-owned sign-in page and session endpoint; leave blank until implemented.
# Login may set an HttpOnly session cookie and redirect back to the frontend.
VITE_GATEWAY_LOGIN_URL=
# Proposed response: {"user": {"id": "...", "name": "..."}} or {"user": null}.
# Path is relative to VITE_GATEWAY_BASE_URL. Not a route implemented by the RAG service.
VITE_GATEWAY_SESSION_PATH=
